<?xml version="1.0" encoding="utf-8"?>
<!-- Kandungan notifikasi ringkasan (senyap): zon, tarikh Hijri,
     6 waktu dan kiraan detik ke waktu seterusnya. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/notif_bg"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/nZone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Waktu Solat"
            android:textColor="#34d399"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/nDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text=""
            android:textColor="#8ba39a"
            android:textSize="9sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="3dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView android:id="@+id/nK0" style="@style/NotifCellLabel" />
            <TextView android:id="@+id/nT0" style="@style/NotifCellTime" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView android:id="@+id/nK1" style="@style/NotifCellLabel" />
            <TextView android:id="@+id/nT1" style="@style/NotifCellTime" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView android:id="@+id/nK2" style="@style/NotifCellLabel" />
            <TextView android:id="@+id/nT2" style="@style/NotifCellTime" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView android:id="@+id/nK3" style="@style/NotifCellLabel" />
            <TextView android:id="@+id/nT3" style="@style/NotifCellTime" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView android:id="@+id/nK4" style="@style/NotifCellLabel" />
            <TextView android:id="@+id/nT4" style="@style/NotifCellTime" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView android:id="@+id/nK5" style="@style/NotifCellLabel" />
            <TextView android:id="@+id/nT5" style="@style/NotifCellTime" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/nNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#8ba39a"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
